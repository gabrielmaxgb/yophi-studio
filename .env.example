# Local / preview → Neon yophi-studio-dev
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.sa-east-1.aws.neon.tech/yophi?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.sa-east-1.aws.neon.tech/yophi?sslmode=require"

BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
STUDIO_EMAIL="hello@yophi.studio"
STUDIO_PASSWORD="change-me-on-first-login"

# Contact form (Resend). From-address domain must be verified.
RESEND_API_KEY=""
CONTACT_FROM="YOPHI <hello@yophi.studio>"
CONTACT_TO="hello@yophi.studio"

# Production (Vercel Production env + .env.production.local):
# Neon project yophi-studio-prod — set DATABASE_URL + DIRECT_URL there.
# Then: npm run db:migrate:prod && STUDIO_* against prod if needed.
